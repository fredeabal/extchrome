{
  "manifest_version": 3,
  "name": "ImporterOtgest",
  "version": "1.2",

  "description": "Importa órdenes de trabajo desde WebGEART, WebGespolT, WebGesvirt y POLAR directamente a OtGest",

  "permissions": [
    "activeTab",
    "storage"
  ],

  "host_permissions": [
    "https://aplicaciones.comfica.com/*",
    "https://polar-tecnicos.orange.es/*",
    "https://otgest.com/*"
  ],

  "content_scripts": [
    {
      "matches": [
        "https://aplicaciones.comfica.com/*",
        "https://polar-tecnicos.orange.es/*"
      ],
      "js": [
        "content.js"
      ],
      "all_frames": true
    },
    {
      "matches": [
        "https://otgest.com/orders/create*"
      ],
      "js": [
        "otgest_autofill.js"
      ]
    }
  ]
}
